BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ustago_db
# or discrete parts (used only if DATABASE_URL is empty):
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
ADMIN_IDS=
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
# REQUIRED, min 32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Comma-separated admin panel origins, e.g. https://admin.example.com
CORS_ORIGINS=
TRUST_PROXY_HEADERS=0

# Business rules (defaults shown)
MAX_BIDS_PER_ORDER=5
# NEW orders nobody was chosen for are closed after this many hours (0 = never)
ORDER_TTL_HOURS=72
# Local time offset used for "do not disturb" (Kazakhstan: 5)
TZ_OFFSET_HOURS=5

# Re-notify masters about an order with no bids (ask the client after N minutes; 0 = off). Local time = TZ_OFFSET_HOURS
# REMINDER_AFTER_MINUTES=15
# WORK_HOURS_START=9
# WORK_HOURS_END=21
